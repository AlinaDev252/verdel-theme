{% doc %}
  Dose, timing and servings from the product's verdel metafields; servings can differ per variant.

  @param {product} product
  @param {block} block
  @param {string} section_id
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign dose = product.metafields.verdel.dose.value
  assign timing = product.metafields.verdel.timing.value
  assign servings = variant.metafields.verdel.servings.value | default: product.metafields.verdel.servings.value
-%}

<verdel-variant-sync
  class="verdel-how-to-take"
  data-key="how-to-take"
  data-section-id="{{ section_id }}"
  {{ block.shopify_attributes }}
>
  {%- if dose != blank or timing != blank or servings != blank -%}
    {%- if block.settings.heading != blank -%}
      <p class="verdel-label">{{ block.settings.heading | escape }}</p>
    {%- endif -%}
    <ul class="verdel-rule-list">
      {%- if dose != blank -%}
        <li><span>Dose</span><span class="verdel-rule-list__amount">{{ dose | escape }}</span></li>
      {%- endif -%}
      {%- if timing != blank -%}
        <li><span>When</span><span class="verdel-rule-list__amount">{{ timing | escape }}</span></li>
      {%- endif -%}
      {%- if servings != blank -%}
        <li><span>Servings per container</span><span class="verdel-rule-list__amount">{{ servings }}</span></li>
      {%- endif -%}
    </ul>
  {%- endif -%}
</verdel-variant-sync>
