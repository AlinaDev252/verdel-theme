{% doc %}
  Lets a bag line switch between one-time and the product's first subscription plan.

  @param {object} item
{% enddoc %}

{%- assign line = item.index | plus: 1 -%}
{%- assign allocation = item.variant.selling_plan_allocations.first -%}
{%- unless customer.b2b? -%}
  {%- if item.selling_plan_allocation -%}
    <div class="verdel-bag-sub__active">
      <p>Subscribed. {{ item.selling_plan_allocation.selling_plan.name | escape }}.</p>
      <button type="button" class="verdel-bag-sub__switch" data-verdel-plan="" data-line="{{ line }}" data-quantity="{{ item.quantity }}">
        Switch to one-time
      </button>
    </div>
  {%- elsif allocation -%}
    {%- assign adjustment = allocation.selling_plan.price_adjustments.first -%}
    {%- liquid
      assign percent_off = 0
      if adjustment.value_type == 'percentage'
        assign percent_off = adjustment.value
      endif
    -%}
    <button
      type="button"
      class="verdel-bag-sub__button"
      data-verdel-plan="{{ allocation.selling_plan.id }}"
      data-line="{{ line }}"
      data-quantity="{{ item.quantity }}"
    >
      <span>{% if percent_off > 0 %}Subscribe and save {{ percent_off }}%{% else %}Subscribe{% endif %}</span>
      {{- 'icon-arrow.svg' | inline_asset_content -}}
    </button>
    <details class="verdel-bag-sub__why">
      <summary>
        <span>Why subscribe?</span>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <ul role="list">
        {%- if percent_off > 0 -%}
          <li>{{ percent_off }}% off every delivery</li>
        {%- endif -%}
        <li>Free US shipping on subscription-only orders</li>
        <li>Change, pause or cancel any time</li>
      </ul>
    </details>
  {%- endif -%}
{%- endunless -%}
