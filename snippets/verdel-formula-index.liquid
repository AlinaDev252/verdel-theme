{% doc %}
  Numbered formula list shared by the shop panel, mobile drawer and footer.

  @param {collection} collection
  @param {string} [class]
{% enddoc %}

<ul class="verdel-index{% if class != blank %} {{ class }}{% endif %}" role="list">
  {%- for item in collection.products -%}
    {%- liquid
      assign number = ''
      assign name = item.title
      if item.title contains 'No. '
        assign number = item.title | slice: 0, 6
        assign name = item.title | slice: 7, 100
      endif
    -%}
    <li>
      <a href="{{ item.url }}"{% if item.id == product.id %} aria-current="page"{% endif %}>
        {%- if number != blank -%}
          <span class="verdel-index__number">{{ number | escape }}</span>
        {%- endif -%}
        <span class="verdel-index__name">{{ name | escape }}</span>
        <span class="verdel-index__price">
          {%- if item.price_varies %}from {% endif -%}
          {{- item.price | money_without_trailing_zeros -}}
        </span>
      </a>
    </li>
  {%- endfor -%}
</ul>
