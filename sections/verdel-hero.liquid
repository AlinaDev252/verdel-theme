{{ 'section-verdel-hero.css' | asset_url | stylesheet_tag }}

<script src="{{ 'verdel-hero-picker.js' | asset_url }}" defer="defer"></script>

<div class="verdel-hero color-{{ section.settings.color_scheme }} gradient">
  {%- unless request.design_mode -%}
    <script>
      if (!sessionStorage.getItem('verdel-intro')) {
        sessionStorage.setItem('verdel-intro', '1');
        document.currentScript.parentElement.classList.add('verdel-hero--intro');
      }
    </script>
  {%- endunless -%}
  <verdel-hero-picker class="page-width verdel-hero__inner">
    <div class="verdel-hero__text">
      <h1 class="h0">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="verdel-hero__lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="verdel-hero__picker">
          <p class="verdel-hero__picker-label" id="HeroPicker-{{ section.id }}">
            {{- section.settings.picker_label | escape -}}
          </p>
          <div class="verdel-hero__tabs" role="tablist" aria-labelledby="HeroPicker-{{ section.id }}">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="verdel-hero__tab"
                role="tab"
                id="HeroTab-{{ block.id }}"
                aria-controls="HeroLabel-{{ block.id }}"
                aria-selected="{{ forloop.first }}"
                {% unless forloop.first %}
                  tabindex="-1"
                {% endunless %}
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | escape -}}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="verdel-hero__link" href="{{ section.settings.link_url }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="verdel-hero__labels">
        {%- for block in section.blocks -%}
          {% render 'verdel-hero-label', block: block, product: block.settings.product, active: forloop.first %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </verdel-hero-picker>
</div>

<div id="verdel-goals" class="verdel-hero__strip color-{{ section.settings.strip_color_scheme }} gradient">
  <div class="page-width">
    {% render 'verdel-trust-badges' %}
  </div>
</div>

{% schema %}
{
  "name": "Verdel hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Read the label. We did." },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "picker_label", "label": "Picker label", "default": "Read the label for" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "select", "id": "assurance_1_icon", "label": "Badge 1 icon", "options": [{ "value": "shipping", "label": "Shipping" }, { "value": "returns", "label": "Returns" }, { "value": "lab", "label": "Lab test" }], "default": "shipping" },
    { "type": "text", "id": "assurance_1", "label": "Badge 1 title", "default": "Free shipping" },
    { "type": "text", "id": "assurance_1_note", "label": "Badge 1 note", "default": "On US orders over $50" },
    { "type": "select", "id": "assurance_2_icon", "label": "Badge 2 icon", "options": [{ "value": "shipping", "label": "Shipping" }, { "value": "returns", "label": "Returns" }, { "value": "lab", "label": "Lab test" }], "default": "returns" },
    { "type": "text", "id": "assurance_2", "label": "Badge 2 title", "default": "60-day returns" },
    { "type": "text", "id": "assurance_2_note", "label": "Badge 2 note", "default": "Even if the bottle is empty" },
    { "type": "select", "id": "assurance_3_icon", "label": "Badge 3 icon", "options": [{ "value": "shipping", "label": "Shipping" }, { "value": "returns", "label": "Returns" }, { "value": "lab", "label": "Lab test" }], "default": "lab" },
    { "type": "text", "id": "assurance_3", "label": "Badge 3 title", "default": "Lab tested" },
    { "type": "text", "id": "assurance_3_note", "label": "Badge 3 note", "default": "Every batch, by an outside lab" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    { "type": "color_scheme", "id": "strip_color_scheme", "label": "Trust badges color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "formula",
      "name": "Formula",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Goal", "default": "Sleep" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-4" }
      ]
    }
  ],
  "presets": [{ "name": "Verdel hero" }]
}
{% endschema %}
