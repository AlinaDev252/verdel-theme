{{ 'section-verdel-editorial.css' | asset_url | stylesheet_tag }}

{%- assign image = section.settings.image -%}
<div class="verdel-editorial color-{{ section.settings.color_scheme }} gradient{% if image != blank %} verdel-editorial--image{% endif %} verdel-editorial--{{ section.settings.image_side }}">
  {%- if image != blank -%}
    <div class="verdel-editorial__media">
      {{
        image
        | image_url: width: 1800
        | image_tag:
          loading: 'lazy',
          alt: image.alt,
          widths: '600, 900, 1200, 1800',
          sizes: '(min-width: 990px) 60vw, 100vw'
      }}
    </div>
  {%- endif -%}
  <div class="verdel-editorial__text">
    {%- if section.settings.eyebrow != blank -%}
      <p class="verdel-label">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="h1">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="verdel-editorial__body">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="verdel-editorial__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Verdel editorial",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell the story behind the formula" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Verdel editorial" }]
}
{% endschema %}
