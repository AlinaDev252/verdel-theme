<div data-verdel-picker-list data-title="{{ collection.title | escape }}">
  {%- assign in_stock = collection.products | where: 'available' -%}
  {%- if in_stock == empty -%}
    <p class="verdel-picker__empty">
      Everything for {{ collection.title | downcase | escape }} is sold out right now.
      <a href="{{ collection.url }}">See the full range</a>
    </p>
  {%- else -%}
    <ul class="verdel-picker__list" role="list">
      {%- for product in in_stock -%}
        {%- assign variant = product.selected_or_first_available_variant -%}
        {%- assign servings = variant.metafields.verdel.servings.value | default: product.metafields.verdel.servings.value -%}
        <li class="verdel-picker-card">
          <a class="verdel-picker-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {%- if product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 240
                | image_tag: loading: 'lazy', alt: '', widths: '120, 240', sizes: '96px'
              }}
            {%- endif -%}
          </a>
          <div class="verdel-picker-card__body">
            <a class="verdel-picker-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
            {%- assign ingredients = product.metafields.verdel.ingredients.value -%}
            {%- if ingredients != blank -%}
              <p class="verdel-picker-card__ingredients">
                {%- for ingredient in ingredients limit: 3 -%}
                  {{- ingredient.name.value | escape -}}
                  {%- unless forloop.last -%},{{ ' ' }}{%- endunless -%}
                {%- endfor -%}
              </p>
            {%- endif -%}
            <div class="verdel-picker-card__buy">
              <p>
                <span class="verdel-picker-card__price">{{ variant.price | money }}</span>
                {%- if servings > 0 -%}
                  {%- unless customer.b2b? -%}
                    {%- assign per_serving = variant.price | times: 1.0 | divided_by: servings | round -%}
                    <span class="verdel-picker-card__serving">{{ per_serving | money }} a serving</span>
                  {%- endunless -%}
                {%- endif -%}
              </p>
              <button
                type="button"
                class="verdel-bag-pick__add"
                data-verdel-add="{{ variant.id }}"
                aria-label="Add {{ product.title | escape }} to bag"
              >
                {{- 'icon-plus.svg' | inline_asset_content -}}
                <span>Add</span>
              </button>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Formula picker results" }
{% endschema %}
