{{ 'section-verdel-subscription.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
  assign allocation = variant.selling_plan_allocations.first
-%}

<div class="verdel-sub-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width verdel-sub-hero__inner">
    <div class="verdel-sub-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="verdel-label">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="h0">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="verdel-sub-hero__lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button button--primary" href="{{ section.settings.button_link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if allocation -%}
      {%- assign yearly_saving = variant.price | minus: allocation.price | times: 12 -%}
      <div class="verdel-sub-math color-{{ section.settings.card_color_scheme }} gradient">
        <p class="verdel-sub-math__title">{{ product.title | escape }}</p>
        <ul class="verdel-rule-list">
          <li><span>One-time</span><span class="verdel-rule-list__amount">{{ variant.price | money }}</span></li>
          <li><span>Subscribed</span><span class="verdel-rule-list__amount">{{ allocation.price | money }}</span></li>
        </ul>
        <p class="verdel-sub-math__total">{{ yearly_saving | money }}</p>
        <p class="verdel-sub-math__note">{{ section.settings.saving_label | escape }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <div class="color-{{ section.settings.strip_color_scheme }} gradient">
    <ul class="page-width verdel-sub-stats" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="verdel-sub-stats__value">{{ block.settings.value | escape }}</span>
          <span>{{ block.settings.label | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Subscription hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Same formula. 15% less." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose a formula" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "product", "id": "product", "label": "Example product" },
    { "type": "text", "id": "saving_label", "label": "Saving label", "default": "saved over 12 deliveries" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    { "type": "color_scheme", "id": "card_color_scheme", "label": "Card color scheme", "default": "scheme-4" },
    { "type": "color_scheme", "id": "strip_color_scheme", "label": "Benefits color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "15%" },
        { "type": "text", "id": "label", "label": "Label", "default": "off every delivery" }
      ]
    }
  ],
  "presets": [{ "name": "Subscription hero" }]
}
{% endschema %}
