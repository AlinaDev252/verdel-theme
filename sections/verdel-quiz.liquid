{{ 'component-verdel-quiz.css' | asset_url | stylesheet_tag }}
<script src="{{ 'verdel-quiz-logic.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'verdel-quiz.js' | asset_url }}" defer="defer"></script>

{%- assign base = section.settings.base -%}
<script type="application/json" data-verdel-quiz-goals>
  {
    "base": { "handle": {{ base.handle | default: '' | json }}, "available": {{ base.available | default: false | json }} },
    "goals": [
      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- assign goal = block.settings.collection -%}
        {%- if goal.products_count > 0 -%}
          {%- unless first -%},{%- endunless -%}
          {%- assign first = false -%}
          {
            "handle": {{ goal.handle | json }},
            "title": {{ goal.title | json }},
            "lead": {{ block.settings.lead.handle | default: '' | json }},
            "products": [
              {%- for product in goal.products -%}
                { "handle": {{ product.handle | json }}, "available": {{ product.available | json }} }
                {%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  }
</script>

<verdel-quiz class="verdel-quiz color-{{ section.settings.color_scheme }} gradient">
  <div class="verdel-quiz__media color-{{ section.settings.media_color_scheme }} gradient">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt,
          widths: '600, 900, 1200, 1800',
          sizes: '(min-width: 990px) 50vw, 100vw'
      }}
    {%- else -%}
      <div class="verdel-quiz__labels">
        {%- for block in section.blocks limit: 3 -%}
          {%- assign lead = block.settings.lead -%}
          {%- if lead.featured_image != blank -%}
            {{ lead.featured_image | image_url: width: 480 | image_tag: loading: 'eager', alt: '', widths: '240, 480', sizes: '180px' }}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="verdel-quiz__panel">
    <div class="verdel-quiz__body">
      <div class="verdel-quiz__intro" data-verdel-quiz-intro>
        <h1 class="h1" tabindex="-1">{{ section.settings.heading | escape }}</h1>
        <p>{{ section.settings.text | escape }}</p>
        <a class="button" href="#quiz=" data-verdel-quiz-start>{{ section.settings.start_label | escape }}</a>
        <noscript>
          <p><a href="{{ routes.collections_url }}/all-formulas">See all formulas</a></p>
        </noscript>
      </div>

      <div class="verdel-quiz__flow" data-verdel-quiz-flow hidden>
        <div class="verdel-quiz__bar">
          <button type="button" class="verdel-quiz__back" data-verdel-quiz-back aria-label="Back">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </button>
          <p class="verdel-quiz__count" data-verdel-quiz-count>Step 1 of 3</p>
        </div>
        <h2 class="h2 verdel-quiz__heading" id="VerdelQuizHeading" tabindex="-1">What do you want to work on?</h2>

        <form data-verdel-quiz-form novalidate>
          <fieldset class="verdel-quiz__step" data-verdel-quiz-step="1">
            <legend class="visually-hidden">What do you want to work on?</legend>
            <p class="verdel-quiz__hint">Pick up to two.</p>
            <div class="verdel-quiz__options">
              {%- for block in section.blocks -%}
                {%- assign goal = block.settings.collection -%}
                {%- if goal.products_count > 0 -%}
                  <label class="verdel-quiz__option" {{ block.shopify_attributes }}>
                    <input type="checkbox" name="goal" value="{{ goal.handle }}">
                    <span>{{ goal.title | escape }}</span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button type="button" class="button verdel-quiz__next" data-verdel-quiz-next disabled>Next</button>
          </fieldset>

          <fieldset class="verdel-quiz__step" data-verdel-quiz-step="2" hidden>
            <legend class="visually-hidden">How do you eat?</legend>
            <div class="verdel-quiz__options">
              <label class="verdel-quiz__option">
                <input type="radio" name="diet" value="plant">
                <span>Fully plant-based</span>
              </label>
              <label class="verdel-quiz__option">
                <input type="radio" name="diet" value="mostly">
                <span>Mostly plant-based</span>
              </label>
              <label class="verdel-quiz__option">
                <input type="radio" name="diet" value="neither">
                <span>Neither</span>
              </label>
            </div>
            <button type="button" class="button verdel-quiz__next" data-verdel-quiz-next disabled>Next</button>
          </fieldset>

          <fieldset class="verdel-quiz__step" data-verdel-quiz-step="3" hidden>
            <legend class="visually-hidden">Already take a multivitamin?</legend>
            <div class="verdel-quiz__options">
              <label class="verdel-quiz__option">
                <input type="radio" name="multi" value="yes">
                <span>Yes</span>
              </label>
              <label class="verdel-quiz__option">
                <input type="radio" name="multi" value="no">
                <span>No</span>
              </label>
            </div>
            <button type="button" class="button verdel-quiz__next" data-verdel-quiz-next disabled>See my formulas</button>
          </fieldset>

          <div data-verdel-quiz-step="4" data-verdel-quiz-result-slot hidden></div>
        </form>

        <p class="verdel-quiz__error" role="alert" data-verdel-quiz-error></p>
      </div>
    </div>

    <p class="verdel-quiz__note">{{ section.settings.note | escape }}</p>
  </div>
</verdel-quiz>

{% schema %}
{
  "name": "Verdel quiz",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your formulas" },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Three questions, about a minute. You get two or three formulas that fit how you live."
    },
    { "type": "text", "id": "start_label", "label": "Start button", "default": "Start" },
    { "type": "product", "id": "base", "label": "Base formula for plant-based diets" },
    {
      "type": "text",
      "id": "note",
      "label": "Health note",
      "default": "We can't give medical advice. If you're pregnant, nursing, take medication or have a health condition, ask your doctor first."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "color_scheme", "id": "media_color_scheme", "label": "Visual color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Goal",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "product", "id": "lead", "label": "Lead formula" }
      ]
    }
  ],
  "presets": [{ "name": "Verdel quiz" }]
}
{% endschema %}
