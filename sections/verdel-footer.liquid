{{ 'section-verdel-footer.css' | asset_url | stylesheet_tag }}

<footer class="verdel-footer color-{{ section.settings.color_scheme }} gradient">
  <div class="verdel-signup-band">
    <div class="page-width">
      <div class="verdel-signup">
        <h2 class="h1 verdel-signup__heading">{{ section.settings.signup_heading | escape }}</h2>
        <p class="verdel-signup__text" id="VerdelFooterHint">{{ section.settings.signup_text | escape }}</p>
        {%- form 'customer', id: 'VerdelFooterSignup', class: 'verdel-signup__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="verdel-signup__status" role="status" tabindex="-1" autofocus>You're on the list.</p>
          {%- else -%}
            <div class="verdel-signup__row">
              <div class="verdel-signup__field">
                <input
                  id="VerdelFooterEmail"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email | escape }}"
                  placeholder=" "
                  autocomplete="email"
                  autocapitalize="none"
                  spellcheck="false"
                  required
                  aria-describedby="VerdelFooterHint{% if form.errors %} VerdelFooterError{% endif %}"
                  {% if form.errors %}
                    aria-invalid="true" autofocus
                  {% endif %}
                >
                <label for="VerdelFooterEmail">{{ section.settings.signup_field_label | escape }}</label>
              </div>
              <button type="submit" class="button">{{ section.settings.signup_button | escape }}</button>
            </div>
            {%- if form.errors -%}
              <p class="verdel-signup__status" id="VerdelFooterError" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

  <div class="page-width verdel-footer__main">
    <div class="verdel-footer__top">
      <div class="verdel-footer__brand">
        <p class="verdel-label verdel-footer__logo">{{ shop.name | escape }}</p>
        {%- if section.settings.statement != blank -%}
          <p class="h1 verdel-footer__statement">{{ section.settings.statement | escape }}</p>
        {%- endif -%}
      </div>

      <nav aria-label="{{ section.settings.goals_label | escape }}">
        <h2 class="verdel-label">{{ section.settings.goals_label | escape }}</h2>
        {%- render 'verdel-collection-index',
          collections: section.settings.goals,
          all_collection: section.settings.formulas,
          all_label: section.settings.all_label,
          class: 'verdel-index--columns'
        -%}
      </nav>

      <nav aria-label="{{ section.settings.quick_links_label | escape }}">
        <h2 class="verdel-label">{{ section.settings.quick_links_label | escape }}</h2>
        <ul class="verdel-index" role="list">
          <li><a href="/pages/subscription"><span class="verdel-index__name">Subscription</span></a></li>
          <li><a href="{{ routes.root_url }}#faq"><span class="verdel-index__name">FAQ</span></a></li>
          {%- if pages['contact'].url != blank -%}
            <li><a href="{{ pages['contact'].url }}"><span class="verdel-index__name">Contact</span></a></li>
          {%- endif -%}
        </ul>
      </nav>
    </div>

    <div class="verdel-footer__bottom">
      <p>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.
        {{ section.settings.demo_note | escape }}
      </p>

      <ul class="verdel-footer__policies" role="list">
        {%- if shop.terms_of_service -%}
          <li><a href="{{ shop.terms_of_service.url }}">Terms of use</a></li>
        {%- endif -%}
        {%- if shop.shipping_policy -%}
          <li><a href="{{ shop.shipping_policy.url }}">Shipping policy</a></li>
        {%- endif -%}
        {%- if shop.refund_policy -%}
          <li><a href="{{ shop.refund_policy.url }}">Refund policy</a></li>
        {%- endif -%}
        {%- if shop.privacy_policy -%}
          <li><a href="{{ shop.privacy_policy.url }}">Privacy policy</a></li>
        {%- endif -%}
      </ul>

      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="verdel-footer__payment" role="list">
          {%- assign own_marks = 'visa,master,american_express,paypal,diners_club,discover' | split: ',' -%}
          {%- for type in shop.enabled_payment_types -%}
            {%- if own_marks contains type -%}
              <li class="verdel-footer__mark verdel-footer__mark--{{ type }}">{{- 'icon-pay-' | append: type | append: '.svg' | inline_asset_content -}}</li>
            {%- else -%}
              <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Verdel footer",
  "class": "section-verdel-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "statement", "label": "Statement", "default": "Read the label. We did." },
    { "type": "text", "id": "demo_note", "label": "Demo note", "default": "Demo store. Products, prices, reviews and testing claims are fictional." },
    { "type": "text", "id": "signup_heading", "label": "Signup heading", "default": "What goes into a formula, and why." },
    { "type": "text", "id": "signup_text", "label": "Signup text", "default": "One email a month. Unsubscribe any time." },
    { "type": "text", "id": "signup_field_label", "label": "Signup field label", "default": "Email" },
    { "type": "text", "id": "signup_button", "label": "Signup button", "default": "Sign up" },
    { "type": "collection", "id": "formulas", "label": "Formulas collection" },
    { "type": "text", "id": "all_label", "label": "All products label", "default": "Shop all" },
    { "type": "collection_list", "id": "goals", "label": "Shop collections", "limit": 10 },
    { "type": "text", "id": "goals_label", "label": "Shop label", "default": "Shop" },
    { "type": "text", "id": "quick_links_label", "label": "Quick links label", "default": "Quick links" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-4" }
  ],
  "presets": [{ "name": "Verdel footer" }]
}
{% endschema %}
