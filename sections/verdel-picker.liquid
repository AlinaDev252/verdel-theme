{{ 'component-verdel-picker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'verdel-quiz-logic.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'verdel-picker.js' | asset_url }}" defer="defer"></script>

{%- assign base = section.settings.base -%}
<script type="application/json" data-verdel-quiz-goals>
  {
    "base": { "handle": {{ base.handle | default: '' | json }}, "available": {{ base.available | default: false | json }} },
    "goals": [
      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- assign goal = block.settings.collection -%}
        {%- if goal.products_count > 0 -%}
          {%- unless first -%},{%- endunless -%}
          {%- assign first = false -%}
          {
            "handle": {{ goal.handle | json }},
            "title": {{ goal.title | json }},
            "lead": {{ block.settings.lead.handle | default: '' | json }},
            "products": [
              {%- for product in goal.products -%}
                { "handle": {{ product.handle | json }}, "available": {{ product.available | json }} }
                {%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  }
</script>

<verdel-picker>
  <dialog class="verdel-picker color-{{ section.settings.color_scheme }} gradient" aria-labelledby="VerdelPickerHeading">
    <div class="verdel-picker__panel">
      <header class="verdel-picker__header">
        <button type="button" class="verdel-picker__icon" data-verdel-picker-back aria-label="Back" hidden>
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </button>
        <h2 class="h2 verdel-picker__heading" id="VerdelPickerHeading" tabindex="-1" autofocus>
          {{- section.settings.heading | escape -}}
        </h2>
        <button type="button" class="verdel-picker__icon" data-verdel-picker-close aria-label="Close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </header>

      <div class="verdel-picker__body">
        <p class="verdel-quiz__count" data-verdel-quiz-count aria-live="polite">Step 1 of 3</p>

        <form class="verdel-quiz" data-verdel-quiz novalidate>
          <fieldset class="verdel-quiz__step" data-verdel-quiz-step="1">
            <legend class="visually-hidden">What are you after?</legend>
            <p class="verdel-quiz__hint">{{ section.settings.text | escape }}</p>
            <div class="verdel-quiz__options">
              {%- for block in section.blocks -%}
                {%- assign goal = block.settings.collection -%}
                {%- if goal.products_count > 0 -%}
                  <label class="verdel-quiz__option" {{ block.shopify_attributes }}>
                    <input type="checkbox" name="goal" value="{{ goal.handle }}">
                    <span>{{ goal.title | escape }}</span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button type="button" class="button verdel-quiz__next" data-verdel-quiz-next disabled>Next</button>
          </fieldset>

          <fieldset class="verdel-quiz__step" data-verdel-quiz-step="2" hidden>
            <legend class="visually-hidden">How do you eat?</legend>
            <div class="verdel-quiz__options verdel-quiz__options--stack">
              <label class="verdel-quiz__option">
                <input type="radio" name="diet" value="plant">
                <span>Fully plant-based</span>
              </label>
              <label class="verdel-quiz__option">
                <input type="radio" name="diet" value="mostly">
                <span>Mostly plant-based</span>
              </label>
              <label class="verdel-quiz__option">
                <input type="radio" name="diet" value="neither">
                <span>Neither</span>
              </label>
            </div>
            <button type="button" class="button verdel-quiz__next" data-verdel-quiz-next disabled>Next</button>
          </fieldset>

          <fieldset class="verdel-quiz__step" data-verdel-quiz-step="3" hidden>
            <legend class="visually-hidden">Already take a multivitamin?</legend>
            <div class="verdel-quiz__options verdel-quiz__options--stack">
              <label class="verdel-quiz__option">
                <input type="radio" name="multi" value="yes">
                <span>Yes</span>
              </label>
              <label class="verdel-quiz__option">
                <input type="radio" name="multi" value="no">
                <span>No</span>
              </label>
            </div>
            <button type="button" class="button verdel-quiz__next" data-verdel-quiz-next disabled>See my stack</button>
          </fieldset>

          <div class="verdel-quiz__step" data-verdel-quiz-step="4" data-verdel-quiz-result-slot hidden></div>
        </form>
      </div>

      <p class="verdel-picker__error" role="alert" data-verdel-picker-error></p>
      <p class="verdel-picker__note">{{ section.settings.note | escape }}</p>
    </div>
  </dialog>
</verdel-picker>

{% schema %}
{
  "name": "Formula picker",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Help me choose" },
    { "type": "text", "id": "text", "label": "Text", "default": "Pick up to two." },
    { "type": "product", "id": "base", "label": "Base formula for plant-based diets" },
    {
      "type": "text",
      "id": "note",
      "label": "Health note",
      "default": "We can't give medical advice. If you're pregnant, nursing, take medication or have a health condition, ask your doctor first."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Goal",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "product", "id": "lead", "label": "Lead formula" }
      ]
    }
  ],
  "presets": [{ "name": "Formula picker" }]
}
{% endschema %}
