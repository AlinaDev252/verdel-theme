{%- assign reviews = product.metafields.verdel.reviews.value -%}
{%- assign rating = product.metafields.reviews.rating.value -%}

{%- if reviews != blank and rating != blank -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'section-verdel-reviews.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {%- liquid
    assign count = product.metafields.reviews.rating_count.value
    assign rating_decimal = 0
    assign decimal = rating.rating | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
      assign rating_decimal = 0.5
    elsif decimal > 0.7
      assign rating_decimal = 1
    endif
  -%}
  <div id="verdel-reviews" class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding verdel-reviews">
      <div class="verdel-reviews__summary">
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        <p class="verdel-reviews__score">{{ rating.rating }}</p>
        <p class="verdel-reviews__count">
          <span
            aria-hidden="true"
            class="rating-star"
            style="--rating: {{ rating.rating | floor }}; --rating-max: {{ rating.scale_max }}; --rating-decimal: {{ rating_decimal }};"
          ></span>
          <span>out of {{ rating.scale_max | round }}, from {{ count }} {{ count | pluralize: 'review', 'reviews' }}</span>
        </p>
      </div>

      <ul class="verdel-reviews__list" role="list">
        {%- for review in reviews -%}
          <li class="verdel-reviews__item">
            <span
              class="rating-star"
              role="img"
              aria-label="{{ review.stars.value }} out of 5"
              style="--rating: {{ review.stars.value }}; --rating-max: 5; --rating-decimal: 0;"
            ></span>
            <h3 class="verdel-reviews__title">{{ review.title.value | escape }}</h3>
            <p class="verdel-reviews__body">{{ review.body.value | escape }}</p>
            <p class="verdel-reviews__meta">
              {{ review.author.value | escape }}, {{ review.date.value | date: '%B %Y' }}
            </p>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 64 }
  ]
}
{% endschema %}
