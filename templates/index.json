    "faq": {
      "type": "verdel-faq",
      "blocks": {
        "q-sub": {
          "type": "question",
          "settings": {
            "question": "How does Subscribe & Save work?",
            "answer": "<p>Choose it on any formula and you pay 15% less on every delivery. A new order ships every 30 days, and shipping is free.</p>"
          }
        },
        "q-cancel": {
          "type": "question",
          "settings": {
            "question": "Can I pause or cancel?",
            "answer": "<p>Yes, any time from your account. Do it before your next order ships and nothing more is charged.</p>"
          }
        },
        "q-ship": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Most orders arrive in 3 to 5 business days. Shipping is free over $50.</p>"
          }
        },
        "q-ret": {
          "type": "question",
          "settings": {
            "question": "What if it isn't for me?",
            "answer": "<p>Send it back within 60 days for a refund, even if the bottle is empty.</p>"
          }
        },
        "q-plant": {
          "type": "question",
          "settings": {
            "question": "Is everything plant-based?",
            "answer": "<p>Yes, even the ingredients that usually aren't. Our vitamin D3 comes from lichen and our omega-3 from algae.</p>"
          }
        },
        "q-lab": {
          "type": "question",
          "settings": {
            "question": "Who tests the formulas?",
            "answer": "<p>An outside lab tests every batch before it ships.</p>"
          }
        },
        "q-dr": {
          "type": "question",
          "settings": {
            "question": "Can I take this with medication?",
            "answer": "<p>Check with your doctor first, and do the same if you're pregnant, breastfeeding or managing a health condition. Bring the label with you. It lists every amount.</p>"
          }
        }
      },
