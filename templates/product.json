          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "subscribe": {
          "type": "subscribe",
          "settings": {
            "heading": "Purchase options"
          }
        },
        "how_to_take": {
          "type": "how_to_take",
          "settings": {
            "heading": "How to take"
          }
        },
        "facts": {
          "type": "facts",
          "settings": {}
        },
        "rating": {
          "type": "rating"
        },
        "assurance": {
          "type": "assurance",
          "settings": {}
        },
        "pair_with": {
          "type": "pair_with",
          "settings": {}
        }
      },
      "block_order": [
        "title",
        "rating",
        "description",
        "price",
        "facts",
        "variant_picker",
        "subscribe",
        "quantity_selector",
        "buy_buttons",
        "assurance",
        "pair_with",
        "how_to_take"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "ingredients": {
      "type": "verdel-ingredients",
      "settings": {
        "source": "product",
        "eyebrow": "Per serving",
        "heading": "What's inside",
        "color_scheme": "scheme-2",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "reviews": {
      "type": "verdel-reviews",
      "settings": {}
    },
    "faq": {
      "type": "verdel-faq",
      "blocks": {
        "q-sub": {
          "type": "question",
          "settings": {
            "question": "How does Subscribe & Save work?",
            "answer": "<p>Choose it on any formula and you pay 15% less on every delivery. A new order ships every 30 days, and shipping is free.</p>"
          }
        },
        "q-cancel": {
          "type": "question",
          "settings": {
            "question": "Can I pause or cancel?",
            "answer": "<p>Yes, any time from your account. Do it before your next order ships and nothing more is charged.</p>"
          }
        },
        "q-ret": {
          "type": "question",
          "settings": {
            "question": "What if it isn't for me?",
            "answer": "<p>Send it back within 60 days for a refund, even if the bottle is empty.</p>"
          }
        },
        "q-dr": {
          "type": "question",
          "settings": {
            "question": "Can I take this with medication?",
            "answer": "<p>Check with your doctor first, and do the same if you're pregnant, breastfeeding or managing a health condition. Bring the label: every amount is on it.</p>"
          }
        }
      },
      "block_order": [
        "q-sub",
        "q-cancel",
        "q-ret",
        "q-dr"
      ],
      "settings": {
        "eyebrow": "Good to know",
        "heading": "Before you order.",
        "color_scheme": "scheme-1"
      }
    }
  },
  "order": [
    "main",
    "ingredients",
    "reviews",
    "faq",
    "disclosures",
    "related-products"
  ]
}
